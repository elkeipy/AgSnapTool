{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgSnapTool",
  "version": "1.5.1",
  "identifier": "com.agsnap.tool",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgSnapTool",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
