{
  "identifier": "default",
  "description": "AgSnapTool gallery window",
  "windows": ["main", "editor-*", "lens-*"],
  "permissions": [
    "core:default",
    "notification:default",
    "allow-shell-state",
    "allow-gallery",
    "allow-open-shot",
    "allow-copy-shots",
    "allow-delete-shots",
    "allow-open-folder",
    "allow-open-log",
    "allow-set-shortcut",
    "allow-set-retention-days",
    "allow-set-language",
    "allow-set-theme",
    "allow-set-panel-open",
    "allow-set-tilt",
    "allow-set-tape-visible",
    "allow-set-tape-width",
    "allow-set-tape-height",
    "allow-set-polaroid",
    "allow-set-caption-size",
    "allow-set-peek",
    "allow-set-gallery-zoom",
    "allow-read-shot",
    "allow-save-edited-shot",
    "allow-window-role",
    "allow-show-editor",
    "allow-hide-editor",
    "allow-take-editor-path",
    "allow-show-lens",
    "allow-hide-lens",
    "allow-take-lens-path"
  ]
}
